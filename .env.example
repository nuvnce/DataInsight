# === DataInsight — variables d'environnement (modèle) ===
# Copier ce fichier en « .env » et remplir les vraies valeurs.
# Le vrai « .env » n'est JAMAIS versionné (voir .gitignore).

# Clé secrète Django — en générer une nouvelle pour la production.
# Générer : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=remplacer-par-une-vraie-cle-secrete

# Mode debug : True en développement, False en production
DJANGO_DEBUG=True

# Hôtes autorisés (séparés par des virgules) en production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données (production PostgreSQL) ---
# En développement, laisser vide pour utiliser SQLite par défaut.
# DB_NAME=datainsight
# DB_USER=datainsight
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
